{
  // Настройки для кода, который работает в Node.js (всё, кроме src/renderer).
  // Используется для проверки типов; сборка — tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["src/renderer"]
}
